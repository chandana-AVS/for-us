# Database Connection (Neon / PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hackathon_db?schema=public"

# Redis Cache
REDIS_URL="redis://localhost:6379"

# Authentication (better-auth)
BETTER_AUTH_SECRET="your-super-secret-key-min-32-chars-long-here!"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# OAuth Credentials (Optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""

# Storage Service (Supabase Storage)
NEXT_PUBLIC_SUPABASE_URL="https://your-supabase-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_STORAGE_BUCKET="attachments"

# Email Service (Resend / SMTP)
RESEND_API_KEY="re_123456789"
FROM_EMAIL="noreply@yourdomain.com"
FROM_NAME="StarterKit Platform"

# Observability
OTEL_SERVICE_NAME="hackathon-starter"
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT="http://localhost:4318/v1/traces"
